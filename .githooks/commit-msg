#!/usr/bin/env bash
# Runs the prose checks, then a local check if one is configured.
set -uo pipefail
root=$(git rev-parse --show-toplevel)

"$root/scripts/check-style.sh" staged "$1" || exit 1

# Optional local check, configured per machine. Skipped silently when unset or
# missing, so a fresh clone works without it.
extra=$(git config --get hooks.extraCheck || true)
[ -n "$extra" ] && [ -x "$extra" ] && { "$extra" "$root" "$1" || exit 1; }

exit 0
